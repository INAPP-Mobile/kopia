# Repository encryption password — auto-generated per deployment via ${{secret(32)}}. NEVER CHANGE after data exists.
KOPIA_PASSWORD=<auto-generated-per-deployment>

# Web UI / API basic-auth password — auto-generated per deployment via ${{secret(32)}}.
KOPIA_SERVER_PASSWORD=<auto-generated-per-deployment>

# HTTP listen port (Railway maps the public domain here)
PORT=51515
